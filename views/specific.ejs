<%- include('templates/common/headerSpecific') %>

<div class="container my-5">

    <div class="card bg-secondary border-0 shadow-lg p-4 rounded-4">

        <div class="d-flex justify-content-between mb-4">
                <% if (data.id == 1) { %>
                <a href="/<%= data.id + 87 %>" class="btn btn-outline-warning px-4">
                    <i class="fas fa-arrow-left me-1"></i> ← Previous
                </a>
                <% } else { %>
                <a href="/<%= data.id - 1 %>" class="btn btn-outline-warning px-4">
                    <i class="fas fa-arrow-left me-1"></i> ← Previous
                </a>
                <% } %>

                <% if (data.id == 88) { %>
                <a href="/<%= data.id - 87 %>" class="btn btn-outline-warning px-4">
                    Next → <i class="fas fa-arrow-right ms-1"></i>
                </a>
                <% } else { %>
                <a href="/<%= data.id + 1 %>" class="btn btn-outline-warning px-4">
                    Next → <i class="fas fa-arrow-right ms-1"></i>
                </a>
                <% } %>
            </div>

            <div class="row g-4 align-items-center">

            <div class="col-md-4 text-center">
                <div class="position-relative rounded overflow-hidden shadow-lg border border-warning border-2">
                    <img src="<%= data.image %>" alt="<%= data.name %>" 
                        class="w-100 h-200 " style="max-height: 400px;">
                </div>
            </div>

            <div class="col-md-8">
                <h2 class="fw-bold text-warning mb-3"><%= data.name %></h2>
                <ul class="list-unstyled">
                    <li><strong>ID:</strong> <%= data.id %></li>
                    <li><strong>Species:</strong> <%= data.species || 'Unknown' %></li>
                    <li><strong>Gender:</strong> <%= data.gender || 'Unknown' %></li>
                    <li><strong>Height:</strong> <%= data.height || 'N/A' %></li>
                    <li><strong>Mass:</strong> <%= data.mass || 'N/A' %></li>
                    <li><strong>Homeworld:</strong> <%= data.homeworld || 'Unknown' %></li>
                    <li><strong>Born:</strong> <%= data.born || 'Unknown' %></li>
                    <li><strong>Died:</strong> <%= data.died || 'Still Alive' %></li>

                    <% if (data.manufacturer) { %>
                        <li><strong>Manufacturer:</strong> <%= data.manufacturer %></li>
                        <li><strong>Model:</strong> <%= data.model %></li>
                    <% } %>

                    <% if (data.affiliations && data.affiliations.length > 0) { %>
                        <li><strong>Affiliations:</strong></li>
                            <ul>
                                <% data.affiliations.forEach(function(aff) { %>
                                    <li><%= aff %></li>
                                <% }); %>
                            </ul>
                    <% } %>

                    <% if (data.formerAffiliations.length > 0) { %>
                        <li><strong>Former Affiliations:</strong></li>
                        <ul>
                            <% data.formerAffiliations.forEach(function(aff) { %>
                                <li><%= aff %></li>
                            <% }); %>
                        </ul>
                    <% } %>

                    <% if (data.masters) { %>
                        <li><strong>Master(s):</strong> <%= data.masters %></li>
                    <% } %>

                    <% if (data.apprentices) { %>
                        <li><strong>Apprentice(s):</strong> <%= data.apprentices %></li>
                    <% } %>

                    <% if (data.species != 'human') { %>
                        <li><strong>Color:</strong> <%= data.skinColor || 'Unknown' %></li>
                    <% } %>

                    <% if (data.cybernetics) { %>
                        <li><strong>Cybernetics:</strong> <%= data.cybernetics %></li>
                    <% } %>

                    <% if (data.diedLocation) { %>
                        <li><strong>Location of Death:</strong> <%= data.diedLocation %></li>
                    <% } %>
                </ul>

                <% if (data.wiki) { %>
                    <a href="<%= data.wiki %>" target="_blank" class="btn btn-warning mt-3 fw-bold">
                    <i class="fas fa-book me-1"></i> Open Wiki Page
                    </a>
                <% } %>
            </div>
        </div>
    </div>
</div>

  <style>
    ul li {
      margin-bottom: 0.4rem;
    }

    .btn-outline-warning {
      border-width: 2px;
    }
  </style>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
