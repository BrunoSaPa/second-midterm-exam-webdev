<%- include('templates/common/headerMain') %>
    <html>

    <body class="bg-dark text-white">
        <h1>Second midterm exam</h1>
        <h2>Star Wars API</h2>
        <div id="container">
            <div id="search">
                <input type="text" id="searchInput" placeholder="Search...">
                <button id="searchButton">Search</button>
            </div>
            <br>
            <div id="list" class="d-flex flex-wrap gap-3">
                <% data.forEach(function(item) { %>

                    <div class="card p-2 bg-secondary text-white" style="width: 150px; text-align: center;">
                        <a href="/<%= item.id %>">
                            <img src="<%= item.image %>" alt="<%= item.name %>" class="img-fluid"
                                style="height: 150px; object-fit: cover;">
                            <div>
                                <%= item.name %>
                            </div>
                        </a>
                    </div>
                    <br>
                    <div>
                    <% }); %>


                        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
                            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
                            crossorigin="anonymous"></script>
    </body>

    </html>

    <%- include('templates/common/footer') %>